# Godot 4+ specific ignores
.godot/
/android/
test_output.log

# Export/build output — the compiled game is rebuilt on demand and far exceeds
# GitHub's 100 MB file cap. Never version it; keep it local only.
build/

# PixelLab scratch (drafts, payloads, api spec)
pl_work/
pl_openapi.json

# Local Claude Code config — .mcp.json holds the PixelLab API token, never commit
.mcp.json
.claude/settings.local.json

# Export SECRETS. export_presets.cfg is safe to version (it is just settings),
# but Godot writes keystore paths and PASSWORDS into this sibling file the
# moment a release keystore is configured. It does not exist yet only because
# debug builds use the auto keystore — ignore it now, before the first real
# signing quietly commits a password.
export_credentials.cfg

# EYES walker logs + screenshots: local test output, never source
eyes_out/

