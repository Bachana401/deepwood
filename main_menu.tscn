theme_override_font_sizes/font_size = 13
text = "You arrive at Deepwood -- once a thriving village, now nearly silent.

The few survivors left are barely alive: trapped somewhere between living and dead by whatever took the rest. One of them begs you for help.

You've fought this enemy before, but only ever in small numbers. As you push further, it becomes clear this was no isolated raid.

Rescue who you can. Rebuild what's left. Find where this began -- and end it."
autowrap_mode = 3

