; THE GAME HAD NO THEME (visual sweep 2026-07-21).
; Godot's built-in Panel box is Color(0.1, 0.1, 0.1, 0.6) -- SIXTY percent
; opaque -- so every window in Deepwood was see-through: the inventory grid
; showed mountains through it, the skill tree showed the sky, the pause menu
; showed the fight you paused. Every panel in every .tscn and every
; Panel.new() in code inherited it.
;
; One default theme fixes all of them at once, and per-node
; add_theme_stylebox_override calls (tooltips, NPC hover cards) still win.
; Palette follows the locked environment style: gloomy slate with a
; weathered-brass edge.
[gd_resource type="Theme" load_steps=2 format=3]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_window"]
content_margin_left = 6.0
content_margin_top = 6.0
content_margin_right = 6.0
content_margin_bottom = 6.0
bg_color = Color(0.086, 0.09, 0.106, 0.97)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.42, 0.38, 0.32, 1)
corner_radius_top_left = 4
corner_radius_top_right = 4
corner_radius_bottom_right = 4
corner_radius_bottom_left = 4

[resource]
Panel/styles/panel = SubResource("StyleBoxFlat_window")
